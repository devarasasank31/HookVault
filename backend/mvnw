# Maven Wrapper Startup Script

# Set up the environment
MAVEN_PROJECT_BASEDIR=${MAVEN_BASEDIR:-"$PWD"}

# Find the wrapper jar
WRAPPER_JAR="$MAVEN_PROJECT_BASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_LAUNCHER=org.apache.maven.wrapper.MavenWrapperMain

# If the wrapper jar doesn't exist, try to download it
if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Maven wrapper not found. Please run 'mvn -N io.takari:maven:wrapper' to generate it."
    exit 1
fi

# Execute Maven
exec "$JAVA_HOME/bin/java" -cp "$WRAPPER_JAR" "$WRAPPER_LAUNCHER" "$@"